{
  "name": "@studio-cgd/site",
  "version": "0.1.0",
  "description": "Studio CGD — ERP in-demand skills site for GitHub Pages (React views in JSX, built by Vite)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-dist": "node scripts/check-dist.mjs",
    "form-config": "node scripts/form-config.mjs",
    "validate-html": "html-validate dist/index.html dist/404.html",
    "check-privacy": "node scripts/check-privacy.mjs",
    "e2e": "playwright test",
    "qa": "npm run build && npm run check-dist && npm run validate-html && npm run check-privacy && npm run e2e -- --project=chromium",
    "scope-sync": "node scripts/scope-sync.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-react": "4.3.1",
    "html-validate": "11.18.0",
    "vite": "5.4.0"
  }
}
